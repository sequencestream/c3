{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "c3",
  "version": "0.1.0",
  "identifier": "center.c3.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "url": "index.html",
        "title": "c3",
        "width": 560,
        "height": 400,
        "resizable": false,
        "center": true,
        "visible": true,
        "focus": true
      },
      {
        "label": "main",
        "url": "main.html",
        "title": "c3",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "c3 — AI workbench",
    "longDescription": "c3 (code creative center) centrally manages and drives the work of multiple AI coding agents. This desktop build embeds the c3 server as a sidecar and renders its Web UI in a native WebView.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/c3"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
